"""Implements `BDD`, a reduced, ordered binary decision diagram, in Mojo.

Diagrams and their algorithms are from Bryant's 1986 paper, [Graph-Based
Algorithms for Boolean Function Manipulation](https://doi.org/10.1109/TC.1986.1676819).
"""

from collections.abc import Iterable, Iterator, Sequence
from typing import ClassVar, final

from typing_extensions import CapsuleType

__all__ = ["BDD"]
__version__: str

@final
class BDD:
    ACCEPT: ClassVar[BDD]
    REJECT: ClassVar[BDD]
    __match_args__ = ("bit", "left", "right")

    def __new__(cls, bit: int, left: BDD, right: BDD) -> BDD: ...
    @property
    def bit(self) -> int: ...
    @property
    def left(self) -> BDD: ...
    @property
    def right(self) -> BDD: ...
    @property
    def size(self) -> int: ...
    @property
    def leaf(self) -> bool: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __invert__(self) -> BDD: ...
    def __and__(self, other: BDD) -> BDD: ...
    def __or__(self, other: BDD) -> BDD: ...
    def __sub__(self, other: BDD) -> BDD: ...
    def __xor__(self, other: BDD) -> BDD: ...
    def __copy__(self) -> BDD: ...
    def __deepcopy__(self, memo: dict[int, object], /) -> BDD: ...

def accepts(node: BDD, value: int) -> bool: ...
def count(node: BDD, *, width: int) -> int: ...
def nth(node: BDD, n: int, *, width: int) -> int: ...
def rank(node: BDD, value: int, *, width: int) -> int: ...
def members(node: BDD, *, width: int) -> Iterator[int]: ...
def blocks(node: BDD, *, width: int) -> Iterator[tuple[int, int]]: ...
def paths(node: BDD, *, width: int) -> Iterator[str]: ...
def tensor(
    node: BDD, *, width: int, code: int, bits: int, version: tuple[int, int] | None
) -> CapsuleType: ...
def lshift(node: BDD, by: int) -> BDD: ...
def freed_between(node: BDD, *, low_bit: int, high_bit: int) -> BDD: ...
def subset(a: BDD, b: BDD) -> bool: ...
def disjoint(a: BDD, b: BDD) -> bool: ...
def narrowed(node: BDD, *, width: int) -> BDD: ...
def node_count(node: BDD) -> int: ...
def path_count(node: BDD) -> int: ...
def count_repr(total: int) -> str: ...
def diagram(bits: str) -> BDD: ...
def exactly_these(values: Iterable[int], *, width: int) -> tuple[BDD, int]: ...
def interval(start: int, stop: int, *, width: int) -> BDD: ...
def _rebuilt(rows: Sequence[tuple[int, int, int]]) -> BDD: ...
def collect() -> int: ...
def stats() -> dict[str, int]: ...
